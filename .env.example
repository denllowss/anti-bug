# ==============================================
# Konfigurasi Environment (opsional di VPS/lokal, wajib di Vercel)
# Salin ke .env atau isi di Vercel > Settings > Environment Variables
# ==============================================

# Port & host (mode standalone: npm start)
PORT=3000
HOST=0.0.0.0

# Password login dashboard web (default: denji##123 — ganti saat online!)
# WEB_PASSWORD=ganti_password_kuat_di_sini

# Rahasia tanda tangan cookie sesi (WAJIB diisi min 32 karakter acak di Vercel)
AUTH_SECRET=

# Kebijakan saat koneksi WhatsApp putus:
#   always = langsung hapus session & kembali ke halaman pairing (default)
#   auth   = hapus session hanya saat logout/401, sisanya auto-reconnect
DISCONNECT_POLICY=always

# Khusus mode Vercel (control plane -> engine di VPS/Railway/Render):
ENGINE_URL=
ENGINE_TOKEN=
